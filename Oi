                    if not string.find(v.Name, "Boss") and (v:FindFirstChild("HumanoidRootPart") and (v.HumanoidRootPart.Position - (plr.Character and plr.Character.HumanoidRootPart.Position or Vector3.new())).Magnitude or math.huge) <= (_G.BringMode or 250) then
