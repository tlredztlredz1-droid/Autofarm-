                            v.HumanoidRootPart.CFrame = (workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin.PrimaryPart and workspace._WorldOrigin.PrimaryPart.CFrame) or v.HumanoidRootPart.CFrame
