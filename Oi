spawn(function()
    while wait(0.2) do
        if _G.AutoFarmNearest and _G.AutoFarmNearestMagnet or _G.SelectMag and _G.BringMonster then
            for _, v in pairs(Workspace:FindFirstChild("Enemies") and Workspace.Enemies:GetChildren() or {}) do
