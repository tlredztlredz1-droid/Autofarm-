-- Distance helper
local function GetDistance(target)
    if not target or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return math.huge end
    return math.floor((target.Position - plr.Character.HumanoidRootPart.Position).Magnitude)
end

-- Teleport helpers
local function TeleportToCFrame(P)
    if not plr.Character or not plr.Character:FindFirstChild("Humanoid") then return end
    repeat wait(0.1)
        pcall(function()
            plr.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            plr.Character.HumanoidRootPart.CFrame = P
        end)
    until (P.Position - plr.Character.HumanoidRootPart.Position).Magnitude <= 5
end

local function TweenTo(Pos, speed)
    if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end
    local Distance = (Pos.Position - plr.Character.HumanoidRootPart.Position).Magnitude
    speed = speed or 300
    TweenService:Create(plr.Character.HumanoidRootPart, TweenInfo.new(math.max(0.01, Distance/speed), Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
end

local function InstancePos(pos)
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        plr.Character.HumanoidRootPart.CFrame = pos
    end
end

-- Generic stop tween helper
local function StopTween()
    _G.StopTween = true
    wait()
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        TweenTo(plr.Character.HumanoidRootPart.CFrame)
    end
    if plr.Character and plr.Character.HumanoidRootPart:FindFirstChild("BodyClip") then
        plr.Character.HumanoidRootPart.BodyClip:Destroy()
    end
    _G.StopTween = false
end

-- Check item in inventory and return it
local function CheckItem(name)
    local inv = safeInvoke("getInventory") or {}
    for _, v in pairs(inv) do
        if v.Name == name then return v end
    end
    return nil
end

