-- Keep a transparent anchored part under the player when certain autos are active
RunService.Heartbeat:Connect(function()
    local needsPart = _G.AutoVampire or _G.AutoFarmChest or _G.AutoAdvanceDungeon or _G.AutoDoughtBoss or _G.Auto_DungeonMobAura or _G.AutoFactory or _G.AutoFarmBossHallow or _G.AutoFarmSwanGlasses
    if needsPart then
        if not Workspace:FindFirstChild("LOL") then
            local LOL = Instance.new("Part")
            LOL.Name = "LOL"
            LOL.Parent = Workspace
            LOL.Anchored = true
            LOL.Transparency = 1
            LOL.Size = Vector3.new(30, -0.5, 30)
        end
        local lol = Workspace:FindFirstChild("LOL")
        if lol and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            lol.CFrame = plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, -3.6, 0)
        end
    else
        if Workspace:FindFirstChild("LOL") then
            Workspace:FindFirstChild("LOL"):Destroy()
        end
    end
end)

-- Prevent collisions while autos are active
RunService.Stepped:Connect(function()
    local needsNoClip = _G.AutoVampire or _G.AutoFarmChest or _G.AutoAdvanceDungeon or _G.AutoDoughtBoss or _G.Auto_DungeonMobAura or _G.AutoFactory or _G.AutoFarmBossHallow or _G.AutoFarmSwanGlasses
    if needsNoClip and plr.Character then
        for _, v in pairs(plr.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end
end)

