-- Remove dodge cooldown by manipulating closures (exploit feature; protected in pcall)
local function NoDodgeCool(enabled)
    if not enabled then return end
    pcall(function()
        if not plr.Character then return end
        if not plr.Character:FindFirstChild("Dodge") then return end
        if type(getgc) ~= "function" then return end
        for _, v in next, getgc() do
            if type(v) == "function" then
                local ok, env = pcall(function() return getfenv(v) end)
                if ok and env and env.script == plr.Character.Dodge then
                    for i2, v2 in next, (getupvalues and getupvalues(v) or {}) do
                        if tostring(v2) == "0.1" then
                            setupvalue(v, i2, 0)
                        end
                    end
                end
            end
        end
    end)
end

-- Fly function (basic implementation)
local function fly()
    local mouse = plr:GetMouse()
    local char = plr.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local torso = char.HumanoidRootPart
    local speedSET = 25
    local keys = {a=false,d=false,w=false,s=false}
    local flying = true
    local pos = Instance.new("BodyPosition", torso)
    local gyro = Instance.new("BodyGyro", torso)
    pos.Name = "EPIXPOS"
    pos.maxForce = Vector3.new(math.huge, math.huge, math.huge)
    pos.position = torso.Position
    gyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    gyro.CFrame = torso.CFrame

    local speed = 1
    local connDown, connUp
    connDown = mouse.KeyDown:Connect(function(key)
        key = key:lower()
        if key == "w" then keys.w = true end
        if key == "s" then keys.s = true end
        if key == "a" then keys.a = true end
        if key == "d" then keys.d = true end
    end)
    connUp = mouse.KeyUp:Connect(function(key)
        key = key:lower()
        if key == "w" then keys.w = false end
        if key == "s" then keys.s = false end
        if key == "a" then keys.a = false end
        if key == "d" then keys.d = false end
    end)

    spawn(function()
        while flying and torso.Parent do
            RunService.Heartbeat:Wait()
            if not (keys.w or keys.s or keys.a or keys.d) then
                speed = 1
            end
            local new = gyro.CFrame - gyro.CFrame.p + pos.position
            if keys.w then
                new = new + workspace.CurrentCamera.CFrame.LookVector * speed
                speed = math.min(speed + speedSET, speedSET)
            end
            if keys.s then
                new = new - workspace.CurrentCamera.CFrame.LookVector * speed
                speed = math.min(speed + speedSET, speedSET)
            end
            if keys.d then
                new = new * CFrame.new(speed,0,0)
                speed = math.min(speed + speedSET, speedSET)
            end
            if keys.a then
                new = new * CFrame.new(-speed,0,0)
                speed = math.min(speed + speedSET, speedSET)
            end
            pos.position = new.p
            if keys.w then
                gyro.CFrame = workspace.CurrentCamera.CFrame * CFrame.Angles(-math.rad(speed*15),0,0)
            elseif keys.s then
                gyro.CFrame = workspace.CurrentCamera.CFrame * CFrame.Angles(math.rad(speed*15),0,0)
            else
                gyro.CFrame = workspace.CurrentCamera.CFrame
            end
        end
        if gyro then gyro:Destroy() end
        if pos then pos:Destroy() end
        if connDown then connDown:Disconnect() end
        if connUp then connUp:Disconnect() end
    end)
end

